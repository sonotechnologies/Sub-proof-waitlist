# Copy to .env.local for local development, and add the same keys in
# Vercel → Project → Settings → Environment Variables.

# Neon Postgres connection string (Neon dashboard → Connection details).
# Use the pooled connection string; keep ?sslmode=require.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Password for /admin/waitlist. Use a long random value, e.g. `openssl rand -base64 24`.
# Leave empty to disable the admin page entirely.
ADMIN_PASSWORD=""

# Public site URL, used for canonical URLs, Open Graph and sitemap.
# On Vercel this falls back to the production domain automatically.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Contact address shown in the footer.
NEXT_PUBLIC_CONTACT_EMAIL="hello@example.com"
